<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Пакеты Godot* (GodotSharp, Godot.SourceGenerators, Godot.NET.Sdk) ОБЯЗАНЫ браться из локального
    источника GodotDouble (собранные вручную пакеты double-precision), а не с nuget.org:
    там лежат официальные float-пакеты той же версии, и несовпадение точности ломает редактор.

    Источник GodotDouble регистрируется на каждом устройстве один раз (см. Docs/01-engine-build.md):
    команда "dotnet nuget add source" с путем к папке GodotSharp/Tools/nupkgs собранного движка
    и именем источника GodotDouble.
  -->
  <packageSourceMapping>
    <packageSource key="GodotDouble">
      <package pattern="Godot*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
